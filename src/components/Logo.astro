---
// The site mark, drawn from public/logo.svg and cropped to the artwork's own bounds
// (x 112..996, y 160..856). Ink and clay switch with the theme.
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
const uid = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['logo', className]}
  width={Math.round(size * (884 / 696))}
  height={size}
  viewBox="112 160 884 696"
  aria-hidden="true"
>
  <defs>
    <clipPath id={`${uid}-c`}>
      <path d="M0 0H1024V409.4L920 432 520 432 520 500 224 519 69 716 0 716Z"></path>
    </clipPath>
    <mask id={`${uid}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
      <g fill="#fff">
        <circle cx="273" cy="466.1" r="161.25"></circle>
        <circle cx="499.45" cy="406.85" r="247.8"></circle>
        <circle cx="804.1" cy="429" r="185.8"></circle>
      </g>
      <g fill="#000">
        <circle cx="282.6" cy="478.35" r="79.7"></circle>
        <circle cx="512.35" cy="434.6" r="174.3"></circle>
        <circle cx="795.7" cy="463.6" r="133.9"></circle>
      </g>
    </mask>
  </defs>
  <rect class="ink" width="1024" height="1024" mask={`url(#${uid}-m)`} clip-path={`url(#${uid}-c)`}></rect>
  <g class="ink">
    <rect x="188" y="652" width="428" height="76"></rect>
    <rect x="268" y="792" width="288" height="64"></rect>
    <rect x="684" y="528" width="68" height="268"></rect>
  </g>
  <rect class="clay" x="800" y="644" width="100" height="24"></rect>
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }

  .ink {
    fill: var(--logo-ink);
  }

  .clay {
    fill: var(--logo-clay);
  }
</style>
