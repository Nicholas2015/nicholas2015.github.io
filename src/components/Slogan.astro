---
// Types each line out, holds it, deletes it, then moves to the next. Loops.
// The caret is the site's own cursor: an ink bar with a clay dash beside it.
// Screen readers get all lines at once; reduced motion shows the first line still.
interface Props {
  lines: string[];
  class?: string;
}

const { lines, class: className } = Astro.props;
---

<p class:list={['slogan-lines', className]} data-lines={JSON.stringify(lines)}>
  <span class="sr">{lines.join('。')}</span>
  <span class="line" aria-hidden="true"><span class="text">{lines[0]}</span><span class="caret"><i></i><b></b></span></span>
</p>

<style>
  /* One fixed line: long lines truncate instead of wrapping, so nothing below ever moves. */
  .slogan-lines {
    height: 1.6em;
    overflow: hidden;
  }

  .line {
    display: flex;
    align-items: center;
    height: 100%;
    min-width: 0;
  }

  .text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .caret {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 1.05em;
    margin-left: 4px;
  }

  .caret i {
    width: 2px;
    height: 100%;
    background: var(--logo-ink);
    border-radius: 1px;
  }

  .caret b {
    width: 0.5em;
    height: 2px;
    margin-top: 0.15em;
    background: var(--logo-clay);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: caret 1.1s steps(1) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      display: none;
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const TYPE = 90;
  const DELETE = 40;
  const HOLD = 2400;
  const GAP = 400;

  for (const el of document.querySelectorAll<HTMLElement>('.slogan-lines[data-lines]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const text = el.querySelector<HTMLElement>('.text');
    if (!text) continue;
    const lines: string[] = JSON.parse(el.dataset.lines ?? '[]');
    if (lines.length === 0) continue;

    // Iterate by code point so CJK is never split.
    const chars = lines.map((l) => Array.from(l));
    let line = 0;
    let shown = chars[0].length;
    let deleting = true;

    const tick = () => {
      if (deleting) {
        shown--;
        text.textContent = chars[line].slice(0, shown).join('');
        if (shown > 0) return setTimeout(tick, DELETE);
        deleting = false;
        line = (line + 1) % chars.length;
        return setTimeout(tick, GAP);
      }
      shown++;
      text.textContent = chars[line].slice(0, shown).join('');
      if (shown < chars[line].length) return setTimeout(tick, TYPE);
      deleting = true;
      setTimeout(tick, HOLD);
    };

    setTimeout(tick, HOLD);
  }
</script>
