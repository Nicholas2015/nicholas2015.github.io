---
import Icon from './Icon.astro';
import ThemedShot from './ThemedShot.astro';
import { PLATFORM_LABEL, STATUS_LABEL, type Tool } from '../lib/content';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const { name, alias, tagline, status, platforms, icon, hero, version } = tool.data;
---

<a class="tool-card" href={`/tools/${tool.id}/`}>
  <div class="shot">
    {hero && <ThemedShot {...hero} alt="" />}
  </div>
  <div class="body">
    <div class="top">
      {icon && <img class="icon" src={icon} alt="" width="40" height="40" />}
      <div class="title">
        <h3>{name}{alias && <span class="alias">{alias}</span>}</h3>
        <p class="meta">
          {platforms.map((p) => PLATFORM_LABEL[p]).join(' · ')}
          {version && <> · v<span class="num">{version}</span></>}
          {status !== 'stable' && <> · {STATUS_LABEL[status]}</>}
        </p>
      </div>
    </div>
    <p class="tagline">{tagline}</p>
    <span class="go arrow-link">了解更多 <Icon name="arrowRight" size={16} /></span>
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .tool-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  /* The real app at the size it's drawn, cropped to its top-left where the navigation lives. */
  .shot {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-sunk);
    border-bottom: 1px solid var(--line);
  }

  .shot :global(.themed-shot) {
    position: absolute;
    top: 0;
    left: 0;
    width: 150%;
    transition: transform 0.4s var(--ease);
    transform-origin: top left;
  }

  .tool-card:hover .shot :global(.themed-shot) {
    transform: scale(1.015);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 24px 24px;
    flex: 1;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  h3 {
    font-size: 18px;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .alias {
    font-size: 15px;
    font-weight: 400;
    color: var(--text-2);
  }

  .meta {
    margin-top: 2px;
    font-size: 13px;
    color: var(--text-3);
  }

  .tagline {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
    flex: 1;
  }

  .go {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .tool-card:hover .go :global(svg) {
    transform: translateX(2px);
  }
</style>
