---
// A slot for a visit count. The numbers come back from the page-view POST in
// BaseLayout, which fills every slot on the page at once; this component only
// decides which count to show, and stays hidden until that number arrives.
interface Props {
  /** Which count to show: this page's views, site-wide views, or unique visitors. */
  field?: 'page_pv' | 'site_pv' | 'site_uv';
  /** Text around the number; `{n}` is replaced with the formatted count. */
  template?: string;
  /** Draw the small dot used between items in the post meta line. */
  dot?: boolean;
}

const { field = 'page_pv', template = '{n} 次阅读', dot = false } = Astro.props;
---

<span class:list={['views', { 'has-dot': dot }]} data-vc={field} data-template={template} hidden></span>

<style>
  .views {
    font-variant-numeric: tabular-nums;
  }

  .views[hidden] {
    display: none !important;
  }

  .views.has-dot {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .views.has-dot::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }
</style>
