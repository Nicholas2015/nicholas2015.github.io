---
// Example of an in-page tool: plain HTML + a small script, no framework needed.
// Astro bundles the <script> and only ships it on pages that use this component.
---

<div class="ts-tool" id="demo">
  <label>
    <span>时间戳（秒或毫秒）</span>
    <input data-ts inputmode="numeric" autocomplete="off" placeholder="例如 1731916800" />
  </label>
  <label>
    <span>日期时间（本地时区）</span>
    <input data-dt type="datetime-local" step="1" />
  </label>
  <div class="row">
    <button type="button" class="btn" data-now>当前时间</button>
    <output data-out></output>
  </div>
</div>

<style>
  .ts-tool {
    display: grid;
    gap: 0.9rem;
    padding: 1.2rem;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  input {
    font: inherit;
    font-family: var(--mono);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.45rem 0.6rem;
    width: 100%;
  }

  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  output {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.ts-tool')) {
    const ts = root.querySelector<HTMLInputElement>('[data-ts]')!;
    const dt = root.querySelector<HTMLInputElement>('[data-dt]')!;
    const out = root.querySelector<HTMLOutputElement>('[data-out]')!;

    const pad = (n: number) => String(n).padStart(2, '0');
    const toLocalInput = (d: Date) =>
      `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;

    const show = (d: Date) => {
      out.textContent = Number.isNaN(d.valueOf()) ? '无效输入' : `UTC ${d.toISOString()}`;
    };

    ts.addEventListener('input', () => {
      const raw = ts.value.trim();
      if (!/^-?\d+$/.test(raw)) return show(new Date(NaN));
      const n = Number(raw);
      const d = new Date(raw.replace('-', '').length > 11 ? n : n * 1000);
      if (!Number.isNaN(d.valueOf())) dt.value = toLocalInput(d);
      show(d);
    });

    dt.addEventListener('input', () => {
      const d = new Date(dt.value);
      if (!Number.isNaN(d.valueOf())) ts.value = String(Math.floor(d.valueOf() / 1000));
      show(d);
    });

    root.querySelector('[data-now]')!.addEventListener('click', () => {
      const d = new Date();
      ts.value = String(Math.floor(d.valueOf() / 1000));
      dt.value = toLocalInput(d);
      show(d);
    });
  }
</script>
