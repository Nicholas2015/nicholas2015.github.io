---
// Blog posts keep the Hexo permalink: /:year/:month/:day/:slug/
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import ViewCount from '../components/ViewCount.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { categoryLabel, excerpt, formatDate, getPosts, postPath, postUrl, tagLabel, type Post } from '../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Related by shared tags, the same category breaking ties. Computed here so each
  // page carries only its own three picks, and newer posts win within a score.
  const relatedFor = (post: Post) => {
    const mine = new Set(post.data.tags);
    return posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        p,
        score: p.data.tags.filter((t) => mine.has(t)).length * 2 + (p.data.category === post.data.category ? 1 : 0),
      }))
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
      .slice(0, 3)
      .map((x) => x.p);
  };
  return posts.map((post, i) => ({
    params: { path: postPath(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: relatedFor(post) },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related?: Post[];
}

const { post, newer, older, related = [] } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, updated, category, tags } = post.data;
// A tag that repeats the category prints the same word twice. The category chip
// already links to the fuller page, so drop the duplicate tag from the row.
const tagChips = tags.filter((tag) => tagLabel(tag).toLowerCase() !== categoryLabel(category).toLowerCase());
// Hand-written posts may open with `# Title`, repeating the page title. Hide it and keep it out of the TOC.
const norm = (s: string) => s.replace(/[\s_，,！!？?。.“”"（）()：:]/g, '').toLowerCase();
const lead = headings[0];
const dupTitle =
  lead?.depth === 1 && (norm(lead.text) === norm(title) || norm(title).startsWith(norm(lead.text)) || norm(lead.text).startsWith(norm(title)))
    ? lead.slug
    : null;
const toc = headings.filter((h) => h.depth <= 3 && h.slug !== dupTitle);
const minDepth = 2;
// Prose at ~400 CJK chars/min; code gets skimmed, roughly 25 lines a minute.
const body = post.body ?? '';
const codeLines = [...body.matchAll(/```[\s\S]*?```/g)].reduce((n, m) => n + m[0].split('\n').length - 2, 0);
const proseChars = body.replace(/```[\s\S]*?```/g, '').replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\s/g, '').length;
const minutes = Math.max(1, Math.round(proseChars / 400 + codeLines / 25));

// Tells search engines what this page is, so results can show the author and date.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: post.data.description ?? excerpt(post.body, 150),
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: new URL(postUrl(post), Astro.site).href,
  inLanguage: 'zh-CN',
  articleSection: categoryLabel(category),
  ...(tags.length ? { keywords: tags.map(tagLabel).join(', ') } : {}),
};
---

<BaseLayout title={title} description={post.data.description ?? excerpt(post.body, 150)} jsonLd={jsonLd}>
  <article class:list={['container post', { 'has-toc': toc.length >= 3 }]}>
    <header class="post-head">
      <a class="back arrow-link" href="/archives/"><Icon name="arrowLeft" size={16} /> 全部文章</a>
      <h1 class="rise">{title}</h1>
      <div class="meta rise rise-2">
        <span>{SITE.author}</span>
        <span class="dot" aria-hidden="true"></span>
        <time class="num" datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && (
          <>
            <span class="dot" aria-hidden="true"></span>
            <span>更新于 <span class="num">{formatDate(updated)}</span></span>
          </>
        )}
        <span class="dot" aria-hidden="true"></span>
        <span>约 {minutes} 分钟</span>
        <ViewCount field="page_pv" dot />
      </div>
      <div class="chips rise rise-2">
        <a class="tag" href={`/categories/${category}/`}>{categoryLabel(category)}</a>
        {tagChips.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tagLabel(tag)}</a>)}
      </div>
    </header>

    <div class:list={['layout']}>
      {toc.length >= 3 && (
        <details class="toc-inline">
          <summary>目录<span class="count num">{toc.length}</span></summary>
          <ol>
            {toc.map((h) => (
              <li style={`--d:${h.depth - minDepth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class:list={['prose', { 'drop-title': dupTitle }]} data-pagefind-body>
        <Content />
      </div>

      {toc.length >= 3 && (
        <aside class="toc" aria-label="目录">
          <p>目录</p>
          <ol>
            {toc.map((h) => (
              <li style={`--d:${h.depth - minDepth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="related" aria-label="相关文章">
        <h2>相关文章</h2>
        <ul>
          {related.map((p) => (
            <li>
              <a href={postUrl(p)}>
                <span class="rt">{p.data.title}</span>
                <span class="rm num">{formatDate(p.data.date)} · {categoryLabel(p.data.category)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="pager" aria-label="上一篇和下一篇">
      {older ? (
        <a href={postUrl(older)}>
          <span class="dir"><Icon name="arrowLeft" size={14} /> 上一篇</span>
          <span class="t">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer && (
        <a class="next" href={postUrl(newer)}>
          <span class="dir">下一篇 <Icon name="arrowRight" size={14} /></span>
          <span class="t">{newer.data.title}</span>
        </a>
      )}
    </nav>
  </article>
  <CodeBlocks />
</BaseLayout>

<script>
  // Give every section a link you can copy, so a single part can be shared.
  for (const heading of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]')) {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${heading.id}`;
    a.setAttribute('aria-label', '链接到这一节');
    a.textContent = '#';
    heading.append(a);
  }

  // Highlight the heading currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a, .toc-inline a')].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  /* One frame for the header, the body and the pager, so their left edges line up.
     With a TOC the frame is body + rail; without one it is just the reading measure. */
  .post {
    --rail: 15rem;
    --gap-rail: 64px;
    --frame: var(--measure);
  }

  @media (min-width: 1121px) {
    .post.has-toc {
      --frame: calc(var(--measure) + var(--gap-rail) + var(--rail));
    }
  }

  .post-head {
    max-width: var(--frame);
    margin-inline: auto;
    padding-top: clamp(40px, 7vw, 80px);
    padding-bottom: clamp(32px, 5vw, 48px);
  }

  .back {
    font-size: 14px;
    color: var(--text-3);
    transition: color 0.15s var(--ease);
  }

  .back:hover {
    color: var(--text);
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(2rem, 4.6vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-top: 20px;
    color: var(--text-3);
    font-size: 14px;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    gap: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
    max-width: var(--frame);
    margin-inline: auto;
  }

  /* The TOC rides in the rail, so the reading column keeps its width and stays centred with the header. */
  @media (min-width: 1121px) {
    .has-toc .layout {
      grid-template-columns: minmax(0, var(--measure)) var(--rail);
    }
  }

  .layout .prose {
    min-width: 0;
  }

  /* The page header already shows the title. */
  .drop-title > :global(h1:first-child) {
    display: none;
  }

  .drop-title > :global(h1:first-child + *) {
    margin-top: 0;
  }

  /* Jumping to a section should not land under the sticky header. */
  .prose :global(:is(h2, h3, h4)[id]) {
    scroll-margin-top: 88px;
  }

  /* The link icon is added by the script, so it needs :global. */
  .prose :global(.anchor) {
    margin-left: 8px;
    font-weight: 400;
    color: var(--text-3);
    opacity: 0;
    transition: opacity 0.15s var(--ease), color 0.15s var(--ease);
  }

  .prose :global(:is(h2, h3, h4):hover .anchor),
  .prose :global(.anchor:focus-visible) {
    opacity: 1;
  }

  .prose :global(.anchor:hover) {
    color: var(--text);
  }

  /* No hover on touch, so keep the mark faintly visible instead of invisible. */
  @media (hover: none) {
    .prose :global(.anchor) {
      opacity: 0.4;
    }
  }

  /* Collapsed table of contents, for widths where the side rail is hidden. */
  .toc-inline {
    display: none;
  }

  @media (max-width: 1120px) {
    .toc-inline {
      display: block;
      grid-column: 1 / -1;
      margin-bottom: 16px;
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--surface);
    }

    .toc-inline summary {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 14px 18px;
      font-size: 14px;
      color: var(--text-2);
      cursor: pointer;
      list-style: none;
    }

    .toc-inline summary::-webkit-details-marker {
      display: none;
    }

    .toc-inline summary::after {
      content: '';
      margin-left: auto;
      width: 7px;
      height: 7px;
      border-right: 1.5px solid var(--text-3);
      border-bottom: 1.5px solid var(--text-3);
      transform: rotate(45deg) translateY(-2px);
      transition: transform 0.15s var(--ease);
    }

    .toc-inline[open] summary::after {
      transform: rotate(-135deg) translateY(-2px);
    }

    .toc-inline .count {
      font-size: 12px;
      color: var(--text-3);
    }

    .toc-inline ol {
      list-style: none;
      margin: 0;
      padding: 0 18px 14px;
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }

    .toc-inline li {
      padding-left: calc(var(--d) * 12px);
    }

    .toc-inline a {
      display: block;
      padding: 6px 0;
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-2);
    }

    .toc-inline a:hover,
    .toc-inline a[aria-current] {
      color: var(--text);
    }
  }

  .toc {
    position: sticky;
    top: 92px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    font-size: 13px;
  }

  .toc p {
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc li {
    padding-left: calc(12px + var(--d) * 12px);
  }

  .toc a {
    display: block;
    padding: 4px 0;
    margin-left: -1px;
    color: var(--text-3);
    line-height: 1.5;
    transition: color 0.15s var(--ease);
  }

  .toc a:hover,
  .toc a[aria-current] {
    color: var(--text);
  }

  .toc a[aria-current] {
    font-weight: 500;
  }

  .toc li:has(a[aria-current]) {
    box-shadow: inset 1px 0 0 var(--text);
  }

  .related {
    max-width: var(--frame);
    margin-inline: auto;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: 15px;
    font-weight: 400;
    color: var(--text-3);
  }

  .related ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .related li + li {
    border-top: 1px solid var(--line);
  }

  .related a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: baseline;
    padding: 14px 12px;
    margin: 0 -12px;
    border-radius: var(--r-md);
    transition: background-color 0.15s var(--ease);
  }

  .related a:hover {
    background: var(--bg-sunk);
  }

  .related .rt {
    font-weight: 500;
    line-height: 1.5;
  }

  .related .rm {
    font-size: 13px;
    color: var(--text-3);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .related a {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .pager {
    max-width: var(--frame);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 72px;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .pager a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  .pager .dir {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--text-3);
  }

  .pager .t {
    font-weight: 500;
    line-height: 1.5;
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
    align-items: flex-end;
  }

  /* Below this width the rail no longer fits beside the text, so the TOC drops and the frame narrows with it. */
  @media (max-width: 1120px) {
    .has-toc .layout {
      grid-template-columns: minmax(0, var(--measure));
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 16px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
