---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { countBy, formatDate, getPosts } from '../lib/content';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const first = posts.at(-1)!;
const latest = posts[0];
const allCategories = countBy(posts.map((p) => p.data.category));
// Show the directions with real weight; one-off categories add noise to the chart.
const categories = allCategories.filter(([, n]) => n >= 3);
const others = allCategories.filter(([, n]) => n < 3).reduce((s, [, n]) => s + n, 0);
const max = categories[0]?.[1] ?? 1;
const contact = SITE.contact;
const years = new Set(posts.map((p) => formatDate(p.data.date).slice(0, 4))).size;
---

<BaseLayout title="关于" description={`${SITE.author}，后端开发者。这里是他的技术笔记`}>
  <div class="container narrow">
    <header class="page-head">
      <h1 class="rise">关于</h1>
      <p class="rise rise-2">{SITE.author} · 后端开发 · {SITE.description}</p>
    </header>

    <div class="prose">
      <p>你好，我是{SITE.author}，一名后端开发者，日常写 Java。</p>
      <p>
        这里的笔记大多来自真实踩过的坑：中间件集群怎么搭、线上问题怎么查、Spring AI 和 LangChain4j 怎么落地。每篇都尽量写成能照着做的步骤，命令和配置可以直接复制。
      </p>
      <p>偶尔也会写点顺手的桌面小工具，放在<a href="/tools/">小工具</a>里。</p>
    </div>

    <section class="facts" aria-label="写作记录">
      <div>
        <p class="v num">{posts.length}</p>
        <p class="k">篇文章</p>
      </div>
      <div>
        <p class="v num">{years}</p>
        <p class="k">个年头有更新</p>
      </div>
      <div>
        <p class="v num">{formatDate(first.data.date).slice(0, 4)}</p>
        <p class="k">写下第一篇</p>
      </div>
      <div>
        <p class="v num">{formatDate(latest.data.date).slice(5)}</p>
        <p class="k">最近一次更新</p>
      </div>
    </section>

    <section class="topics">
      <h2>写得最多的方向</h2>
      <ul class="bars">
        {categories.map(([name, n], i) => (
          <li style={`--w:${(n / max) * 100}%`} class:list={{ lead: i === 0 }}>
            <a href={`/categories/${name}/`}>
              <span class="name">{name}</span>
              <span class="bar" aria-hidden="true"><i></i></span>
              <span class="count num">{n} 篇</span>
            </a>
          </li>
        ))}
      </ul>
      {others > 0 && <p class="others">另有 <span class="num">{others}</span> 篇在其他分类 · <a href="/tags/">查看全部分类</a></p>}
    </section>

    <section class="contact">
      <h2>找到我</h2>
      <div class="socials" data-contact={contact}>
        <a class="social" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
          <Icon name="github" size={20} />
          <span class="tip" aria-hidden="true">GitHub</span>
        </a>
        <!-- href is filled in on first hover/focus, so the address is not in the HTML source -->
        <a class="social" data-mail aria-label="发邮件">
          <Icon name="mail" size={20} />
          <span class="tip" aria-hidden="true">发邮件</span>
        </a>
        <button type="button" class="social" data-qq aria-label="QQ，点击复制号码">
          <Icon name="qq" size={20} />
          <span class="tip" aria-hidden="true" data-qq-tip>QQ</span>
        </button>
        <a class="social" href="/subscribe/" aria-label="RSS 订阅">
          <Icon name="rssSolid" size={18} />
          <span class="tip" aria-hidden="true">RSS 订阅</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Contact details are stored encoded and only written into the page after a click,
  // so they never appear as plain text in the HTML that crawlers read.
  const root = document.querySelector<HTMLElement>('.socials[data-contact]');
  if (root) {
    let values: { email: string; qq: string } | null = null;
    const decode = () => {
      if (values) return values;
      const bytes = Uint8Array.from(atob(root.dataset.contact ?? ''), (c) => c.charCodeAt(0));
      return (values = JSON.parse(new TextDecoder().decode(bytes)) as { email: string; qq: string });
    };

    // Email: a plain mailto link, with the address written in only when someone reaches for it.
    const mail = root.querySelector<HTMLAnchorElement>('[data-mail]');
    if (mail) {
      const arm = () => {
        if (!mail.href) mail.href = `mailto:${decode().email}`;
      };
      ['pointerenter', 'focus', 'touchstart'].forEach((t) => mail.addEventListener(t, arm, { passive: true }));
      mail.addEventListener('click', arm);
      mail.tabIndex = 0;
    }

    // QQ: the tooltip shows the number; a click copies it.
    const qq = root.querySelector<HTMLButtonElement>('[data-qq]');
    const tip = qq?.querySelector<HTMLElement>('[data-qq-tip]');
    if (qq && tip) {
      const show = () => (tip.textContent = `QQ ${decode().qq} · 点击复制`);
      ['pointerenter', 'focus'].forEach((t) => qq.addEventListener(t, show));
      qq.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(decode().qq);
          tip.textContent = `已复制 ${decode().qq}`;
        } catch {
          tip.textContent = `QQ ${decode().qq}`;
        }
        qq.dataset.pinned = '';
      });
      qq.addEventListener('pointerleave', () => delete qq.dataset.pinned);
      qq.addEventListener('blur', () => delete qq.dataset.pinned);
    }
  }
</script>

<style>
  .narrow {
    max-width: calc(var(--measure) + var(--gutter) * 2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .facts > div {
    padding: 20px 24px;
  }

  .facts > div + div {
    border-left: 1px solid var(--line);
  }

  .v {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
  }

  .k {
    margin-top: 4px;
    font-size: 13px;
    color: var(--text-3);
  }

  section h2 {
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  .topics,
  .contact {
    margin-top: 56px;
  }

  /* Ranked bars: no grey track behind them, so the bars alone show the proportion.
     The lead uses the logo ink; the rest are a soft tint of the same green. */
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .bars a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 16px;
    height: 36px;
    padding: 0 12px;
    margin: 0 -12px;
    border-radius: var(--r-md);
    font-size: 15px;
    transition: background-color 0.15s var(--ease);
  }

  .bars a:hover {
    background: var(--bg-sunk);
  }

  .bar {
    display: block;
    height: 12px;
  }

  .bar i {
    display: block;
    width: max(var(--w), 6px);
    height: 100%;
    border-radius: 3px;
    background: color-mix(in srgb, var(--logo-ink) 22%, var(--bg));
    transition: background-color 0.15s var(--ease);
  }

  .bars a:hover .bar i {
    background: color-mix(in srgb, var(--logo-ink) 40%, var(--bg));
  }

  .bars .lead .bar i {
    background: var(--logo-ink);
  }

  .bars .lead .name,
  .bars .lead .count {
    color: var(--text);
    font-weight: 500;
  }

  .others {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-3);
  }

  .others a {
    color: var(--accent);
  }

  .count {
    text-align: right;
    color: var(--text-3);
    font-size: 13px;
  }

  /* Contact: a quiet row of solid marks; email and QQ reveal in a popover. */
  .socials {
    position: relative;
    display: flex;
    gap: 8px;
  }

  .social {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .social:hover,
  .social:focus-visible {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--bg-sunk);
  }

  /* Tooltip: a small dark label above the icon, shown on hover and keyboard focus. */
  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    z-index: 5;
    padding: 4px 8px;
    border-radius: var(--r-sm);
    background: var(--text);
    color: var(--bg);
    font: 400 12px/1.5 var(--font);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity 0.15s var(--ease), transform 0.15s var(--ease);
  }

  .tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -4px;
    border: 4px solid transparent;
    border-top-color: var(--text);
  }

  .social:hover .tip,
  .social:focus-visible .tip,
  .social[data-pinned] .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Leave room above the icons for the tooltip. */
  .contact h2 {
    margin-bottom: 44px;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts > div:nth-child(3) {
      border-left: 0;
    }
    .facts > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
