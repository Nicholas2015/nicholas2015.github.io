---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { countBy, formatDate, getPosts } from '../lib/content';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const first = posts.at(-1)!;
const latest = posts[0];
const allCategories = countBy(posts.map((p) => p.data.category));
// Show the directions with real weight; one-off categories add noise to the chart.
const categories = allCategories.filter(([, n]) => n >= 3);
const others = allCategories.filter(([, n]) => n < 3).reduce((s, [, n]) => s + n, 0);
const max = categories[0]?.[1] ?? 1;
const contact = SITE.contact;
const years = new Set(posts.map((p) => formatDate(p.data.date).slice(0, 4))).size;
---

<BaseLayout title="关于" description={`${SITE.author}，后端开发者。这里是他的技术笔记`}>
  <div class="container narrow">
    <header class="page-head">
      <h1 class="rise">关于</h1>
      <p class="rise rise-2">{SITE.author} · 后端开发 · {SITE.description}</p>
    </header>

    <div class="prose">
      <p>你好，我是{SITE.author}，一名后端开发者，日常写 Java。</p>
      <p>
        这里的笔记大多来自真实踩过的坑：中间件集群怎么搭、线上问题怎么查、Spring AI 和 LangChain4j 怎么落地。每篇都尽量写成能照着做的步骤，命令和配置可以直接复制。
      </p>
      <p>偶尔也会写点顺手的桌面小工具，放在<a href="/tools/">小工具</a>里。</p>
    </div>

    <section class="facts" aria-label="写作记录">
      <div>
        <p class="v num">{posts.length}</p>
        <p class="k">篇文章</p>
      </div>
      <div>
        <p class="v num">{years}</p>
        <p class="k">个年头有更新</p>
      </div>
      <div>
        <p class="v num">{formatDate(first.data.date).slice(0, 4)}</p>
        <p class="k">写下第一篇</p>
      </div>
      <div>
        <p class="v num">{formatDate(latest.data.date).slice(5)}</p>
        <p class="k">最近一次更新</p>
      </div>
    </section>

    <section class="topics">
      <h2>写得最多的方向</h2>
      <ul>
        {categories.map(([name, n]) => (
          <li>
            <a href={`/categories/${name}/`}>
              <span class="name">{name}</span>
              <span class="bar" style={`--w:${(n / max) * 100}%`} aria-hidden="true"></span>
              <span class="count num">{n}</span>
            </a>
          </li>
        ))}
      </ul>
      {others > 0 && <p class="others">另有 <span class="num">{others}</span> 篇在其他分类，<a href="/tags/">查看全部</a></p>}
    </section>

    <section class="contact">
      <h2>找到我</h2>
      <div class="socials" data-contact={contact}>
        <a class="social" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
          <Icon name="github" size={20} />
        </a>
        <button type="button" class="social" data-reveal="email" aria-label="邮箱" title="邮箱" aria-expanded="false">
          <Icon name="mail" size={20} />
        </button>
        <button type="button" class="social" data-reveal="qq" aria-label="QQ" title="QQ" aria-expanded="false">
          <Icon name="qq" size={20} />
        </button>
        <a class="social" href="/subscribe/" aria-label="RSS 订阅" title="RSS 订阅">
          <Icon name="rssSolid" size={18} />
        </a>

        <div class="pop" role="dialog" aria-label="联系方式" hidden>
          <span class="pk" data-pop-label></span>
          <span class="pv num" data-pop-value></span>
          <div class="pa">
            <a class="mini" data-pop-mail>写邮件</a>
            <button type="button" class="mini" data-pop-copy>复制</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Contact details are stored encoded and only written into the page after a click,
  // so they never appear as plain text in the HTML that crawlers read.
  const root = document.querySelector<HTMLElement>('.socials[data-contact]');
  const pop = root?.querySelector<HTMLElement>('.pop');
  if (root && pop) {
    const label = pop.querySelector('[data-pop-label]')!;
    const value = pop.querySelector('[data-pop-value]')!;
    const mail = pop.querySelector<HTMLAnchorElement>('[data-pop-mail]')!;
    const copy = pop.querySelector<HTMLButtonElement>('[data-pop-copy]')!;
    const triggers = [...root.querySelectorAll<HTMLButtonElement>('[data-reveal]')];
    let values: { email: string; qq: string } | null = null;
    let current: HTMLButtonElement | null = null;

    const decode = () => {
      if (values) return values;
      const bytes = Uint8Array.from(atob(root.dataset.contact ?? ''), (c) => c.charCodeAt(0));
      return (values = JSON.parse(new TextDecoder().decode(bytes)));
    };

    const close = () => {
      pop.hidden = true;
      current?.setAttribute('aria-expanded', 'false');
      current = null;
    };

    const open = (btn: HTMLButtonElement) => {
      const field = btn.dataset.reveal as 'email' | 'qq';
      const v = decode()![field];
      label.textContent = field === 'email' ? '邮箱' : 'QQ';
      value.textContent = v;
      mail.style.display = field === 'email' ? '' : 'none';
      if (field === 'email') mail.href = `mailto:${v}`;
      copy.textContent = '复制';
      current?.setAttribute('aria-expanded', 'false');
      current = btn;
      btn.setAttribute('aria-expanded', 'true');
      // Anchor the popover under the icon that opened it.
      pop.style.setProperty('--x', `${btn.offsetLeft + btn.offsetWidth / 2}px`);
      pop.hidden = false;
    };

    triggers.forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        current === btn && !pop.hidden ? close() : open(btn);
      }),
    );

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value.textContent ?? '');
        copy.textContent = '已复制';
      } catch {
        copy.textContent = '复制失败';
      }
    });

    pop.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pop.hidden) {
        const btn = current;
        close();
        btn?.focus();
      }
    });
  }
</script>

<style>
  .narrow {
    max-width: calc(var(--measure) + var(--gutter) * 2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 48px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .facts > div {
    padding: 20px 24px;
  }

  .facts > div + div {
    border-left: 1px solid var(--line);
  }

  .v {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
  }

  .k {
    margin-top: 4px;
    font-size: 13px;
    color: var(--text-3);
  }

  section h2 {
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  .topics,
  .contact {
    margin-top: 56px;
  }

  .topics ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .topics a {
    display: grid;
    grid-template-columns: 6rem 1fr 3rem;
    align-items: center;
    gap: 16px;
    height: 36px;
    padding: 0 12px;
    margin: 0 -12px;
    border-radius: var(--r-md);
    font-size: 15px;
    transition: background-color 0.15s var(--ease);
  }

  .topics a:hover {
    background: var(--bg-sunk);
  }

  .bar {
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }

  .bar::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 2px;
    background: var(--text-3);
  }

  .topics li:first-child .bar::after {
    background: var(--logo-clay);
  }

  .others {
    margin-top: 12px;
    font-size: 13px;
    color: var(--text-3);
  }

  .others a {
    color: var(--accent);
  }

  .count {
    text-align: right;
    color: var(--text-3);
    font-size: 14px;
  }

  /* Contact: a quiet row of solid marks; email and QQ reveal in a popover. */
  .socials {
    position: relative;
    display: flex;
    gap: 8px;
  }

  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .social:hover,
  .social[aria-expanded='true'] {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--bg-sunk);
  }

  .pop {
    position: absolute;
    top: calc(100% + 8px);
    left: clamp(0px, calc(var(--x, 0px) - 9rem), calc(100% - 18rem));
    z-index: 5;
    width: min(18rem, 100%);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 4px 12px;
    padding: 12px 12px 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }

  .pop[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pop:not([hidden]) {
      animation: pop-in 0.18s var(--ease);
    }
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .pk {
    font-size: 13px;
    color: var(--text-3);
  }

  .pv {
    font-size: 15px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    user-select: all;
  }

  .pa {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 8px;
  }

  .mini {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text-2);
    font: 400 12px/1 var(--font);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .mini:hover {
    border-color: var(--text-3);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts > div:nth-child(3) {
      border-left: 0;
    }
    .facts > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
