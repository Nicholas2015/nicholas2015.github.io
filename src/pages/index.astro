---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import Icon from '../components/Icon.astro';
import Typewriter from '../components/Typewriter.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
import { countBy, excerpt, formatDate, getPosts, getTools, postUrl, type Post } from '../lib/content';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const tools = await getTools();
const featured = (tools.some((t) => t.data.featured) ? tools.filter((t) => t.data.featured) : tools).slice(0, 3);

// One lead story, then a compact list of the next ones.
const [lead, ...rest] = posts;
const recent = rest.slice(0, 6);

// Topic tabs: categories with a real body of posts, newest six each.
const topics = countBy(posts.map((p) => p.data.category))
  .filter(([, n]) => n >= 3)
  .slice(0, 6)
  .map(([name, n]) => ({ name, n, items: posts.filter((p) => p.data.category === name).slice(0, 6) }));

const firstYear = posts.at(-1)?.data.date.getFullYear();
const md = (p: Post) => formatDate(p.data.date).slice(5);

// The step card shows a real sequence from a real post, so readers see what the notes are like.
// Taken verbatim from "Spring AI 接 Ollama，本地大模型 RAG 实战".
const stepPost = posts.find((p) => p.id === 'spring_ai接ollama_本地大模型rag实战') ?? lead;
const steps = `# 对话模型，7B 在 16G 内存的机器上能跑
ollama pull qwen2.5:7b

# Embedding 模型，负责把文字转向量
ollama pull nomic-embed-text

# 确认服务起来了，默认监听 11434
ollama serve`;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="intro">
        <p class="stat rise">
          <span class="num">{firstYear}</span> 年起 · <span class="num">{posts.length}</span> 篇 · 最近更新 <span class="num">{formatDate(lead.data.date).slice(5)}</span>
        </p>
        <h1 class="rise">
          <Logo size={56} class="mark" />
          <span>{SITE.title}</span>
        </h1>
        <Typewriter lines={SITE.slogans} class="slogan rise rise-2" />
        <p class="lead rise rise-2">
          {SITE.author}的技术笔记。Spring AI、RAG、Kafka、Redis、线上排查，一步一步讲清楚，命令可以直接复制
        </p>
        <div class="cta rise rise-3">
          <a class="btn btn-primary arrow-link" href="/archives/">阅读文章 <Icon name="arrowRight" size={16} /></a>
          <a class="btn" href="/subscribe/"><Icon name="rss" size={16} /> 订阅</a>
        </div>
      </div>

      <figure class="step rise rise-3">
        <a class="step-head" href={postUrl(stepPost)}>
          <span class="step-meta num">{formatDate(stepPost.data.date)} · {stepPost.data.category}</span>
          <span class="step-title">{stepPost.data.title}</span>
        </a>
        <div class="code-frame" data-static>
          <div class="code-bar">
            <span>shell</span>
            <button type="button" class="copy" aria-label="复制命令"></button>
          </div>
          <Code code={steps} lang="shell" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
        </div>
        <figcaption>
          <a class="arrow-link" href={postUrl(stepPost)}>接着看完整步骤 <Icon name="arrowRight" size={14} /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>最新</h2>
      <a class="more arrow-link" href="/archives/">全部 <span class="num">{posts.length}</span> 篇 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="latest">
      <a class="lead-post" href={postUrl(lead)}>
        <span class="meta num">{formatDate(lead.data.date)} · {lead.data.category}</span>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.description ?? excerpt(lead.body, 150)}</p>
        <span class="read arrow-link">阅读全文 <Icon name="arrowRight" size={16} /></span>
      </a>
      <ul class="compact">
        {recent.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="d num">{md(p)}</span>
              <span class="t">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>按方向读</h2>
      <a class="more arrow-link" href="/tags/">全部分类和标签 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="topics" data-topics>
      <div class="tabs" role="tablist" aria-label="按方向筛选">
        {topics.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`topic-tab-${i}`}
            aria-controls={`topic-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {t.name}<span class="n num">{t.n}</span>
          </button>
        ))}
      </div>
      {topics.map((t, i) => (
        <div class="panel" role="tabpanel" id={`topic-panel-${i}`} aria-labelledby={`topic-tab-${i}`} hidden={i !== 0}>
          <ul>
            {t.items.map((p) => (
              <li>
                <a href={postUrl(p)}>
                  <span class="d num">{md(p)}</span>
                  <span class="t">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="panel-more arrow-link" href={`/categories/${t.name}/`}>{t.name} 全部 <span class="num">{t.n}</span> 篇 <Icon name="arrowRight" size={14} /></a>
        </div>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>小工具</h2>
        <a class="more arrow-link" href="/tools/">全部工具 <Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="tool-grid">
        {featured.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>
  )}
  <CodeBlocks />
</BaseLayout>

<script>
  // Tabs for the topic list: click or arrow keys switch the panel, following the WAI-ARIA tabs pattern.
  for (const root of document.querySelectorAll<HTMLElement>('[data-topics]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + tabs.length) % tabs.length, true);
      });
    });
  }
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  /* Mark and name read as one lockup; the mark is sized to the cap height of the name. */
  h1 {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  h1 :global(.mark) {
    width: auto;
    height: 0.8em;
  }

  .hero :global(.slogan) {
    margin-top: 20px;
    max-width: 32rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--text-3);
  }

  .lead {
    margin-top: 12px;
    max-width: 32rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-2);
  }

  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Facts sit above the name as a quiet line, so the buttons end the block. */
  .stat {
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--text-3);
  }

  /* The one rich moment: a real step from a real note. */
  .step {
    margin: 0;
    padding: 8px;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }

  .step-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 16px;
  }

  .step-meta {
    font-size: 12px;
    color: var(--text-3);
  }

  .step-title {
    font-weight: 500;
    font-size: 15px;
    transition: color 0.15s var(--ease);
  }

  .step-head:hover .step-title {
    color: var(--accent);
  }

  .step .code-frame {
    border-radius: var(--r-md);
  }

  .step :global(pre) {
    margin: 0;
    padding: 16px 20px;
    font: 400 13.5px/1.75 var(--mono);
    background: var(--code-bg) !important;
    overflow-x: auto;
  }

  .step figcaption {
    padding: 12px 12px 8px;
    font-size: 14px;
  }

  .step figcaption a {
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .step figcaption a:hover {
    color: var(--text);
  }

  .block {
    padding-top: clamp(64px, 9vw, 96px);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .block-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }

  .more {
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .more:hover {
    color: var(--text);
  }

  /* Latest: one lead story beside a compact list */
  .latest {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .lead-post {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lead-post .meta {
    font-size: 13px;
    color: var(--text-3);
  }

  .lead-post h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.3;
    transition: color 0.15s var(--ease);
  }

  .lead-post:hover h3 {
    color: var(--accent);
  }

  .lead-post p {
    color: var(--text-2);
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lead-post .read {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
  }

  .lead-post:hover .read :global(svg) {
    transform: translateX(2px);
  }

  .compact {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compact li + li {
    border-top: 1px solid var(--line);
  }

  .compact a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    font-size: 15px;
  }

  .compact li:first-child a {
    padding-top: 0;
  }

  .compact .d {
    font-size: 13px;
    color: var(--text-3);
  }

  .compact .t {
    transition: color 0.15s var(--ease);
  }

  .compact a:hover .t {
    color: var(--accent);
  }

  /* Topics: one row of tabs, one list. The list keeps the same height whichever tab is open. */
  .topics {
    border-top: 1px solid var(--line);
  }

  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .tabs button {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-md);
    background: transparent;
    color: var(--text-2);
    font: 400 15px/36px var(--font);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .tabs button:hover {
    color: var(--text);
    background: var(--bg-sunk);
  }

  .tabs button[aria-selected='true'] {
    color: var(--bg);
    background: var(--text);
  }

  .tabs .n {
    font-size: 12px;
    opacity: 0.6;
  }

  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
  }

  .panel li {
    border-bottom: 1px solid var(--line);
  }

  .panel li a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 16px 0;
    font-size: 15px;
  }

  .panel .d {
    font-size: 13px;
    color: var(--text-3);
  }

  .panel .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .panel li a:hover .t {
    color: var(--accent);
  }

  .panel-more {
    margin-top: 20px;
    font-size: 14px;
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .panel-more:hover {
    color: var(--text);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 24px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 56px;
      padding-bottom: 64px;
    }
    h1 {
      font-size: 2.75rem;
    }
    .latest {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .panel ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    /* Commands scroll inside the frame; shrink a step so the common lines fit. */
    .step :global(pre) {
      font-size: 12.5px;
      padding: 16px;
    }
  }
</style>
