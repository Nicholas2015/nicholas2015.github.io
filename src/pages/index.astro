---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ThemedShot from '../components/ThemedShot.astro';
import { WEB_TOOLS } from '../lib/webtools';
import CodeBlocks from '../components/CodeBlocks.astro';
import Icon from '../components/Icon.astro';
import Typewriter from '../components/Typewriter.astro';
import ViewCount from '../components/ViewCount.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../consts';
import { categoryLabel, countBy, excerpt, formatDate, getPosts, getTools, postUrl, type Post } from '../lib/content';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const tools = await getTools();
const featured = (tools.some((t) => t.data.featured) ? tools.filter((t) => t.data.featured) : tools).slice(0, 3);

// The hero shows the desktop tools as they actually look, so a first-time reader
// sees something built, not another list. Only tools with a screenshot qualify.
const heroTools = (tools.some((t) => t.data.featured) ? tools.filter((t) => t.data.featured) : tools)
  .filter((t) => t.data.hero)
  .slice(0, 2);

// One lead story, then a compact list of the next ones.
const [lead, ...rest] = posts;
const recent = rest.slice(0, 6);

// Topic tabs: categories with a real body of posts, newest six each.
// Kept keyed by the slug, since it drives the per-category lookup; only the tab shows the label.
const topics = countBy(posts.map((p) => p.data.category))
  .filter(([, n]) => n >= 3)
  .slice(0, 6)
  .map(([slug, n]) => ({ slug, label: categoryLabel(slug), n, items: posts.filter((p) => p.data.category === slug).slice(0, 6) }));

const firstYear = posts.at(-1)?.data.date.getFullYear();
const md = (p: Post) => formatDate(p.data.date).slice(5);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="intro">
        <p class="stat rise">
          <span class="num">{firstYear}</span> 年起 · <span class="num">{posts.length}</span> 篇 · 最近更新 <span class="num">{formatDate(lead.data.date).slice(5)}</span>
          <ViewCount field="site_pv" template=" · 累计 {n} 次浏览" />
          <ViewCount field="site_uv" template=" · {n} 位访客" />
        </p>
        <h1 class="rise">
          <Logo size={56} class="mark" />
          <span>{SITE.title}</span>
        </h1>
        <Typewriter lines={SITE.slogans} class="slogan rise rise-2" />
        <p class="lead rise rise-2">
          {SITE.author}的技术笔记。Spring AI、RAG、Kafka、Redis、线上排查，一步一步讲清楚，命令可以直接复制
        </p>
        <div class="cta rise rise-3">
          <a class="btn btn-primary arrow-link" href="/archives/">阅读文章 <Icon name="arrowRight" size={16} /></a>
          <a class="btn" href="/subscribe/"><Icon name="rss" size={16} /> 订阅</a>
        </div>
      </div>

      <figure class="showcase rise rise-3">
        <div class="stage" style={`aspect-ratio:${heroTools[0].data.hero!.width}/${heroTools[0].data.hero!.height}`}>
          {heroTools.map((t, i) => (
            <a
              class="frame"
              data-panel={t.id}
              data-name={t.data.name}
              data-alias={t.data.alias}
              data-tagline={t.data.tagline}
              href={`/tools/${t.id}/`}
              data-active={i === 0 ? '' : undefined}
              data-behind={i === 1 ? '' : undefined}
              aria-hidden={i === 0 ? undefined : 'true'}
              tabindex={i === 0 ? 0 : -1}
            >
              <ThemedShot base={t.data.hero!.base} alt={t.data.hero!.alt} width={t.data.hero!.width} height={t.data.hero!.height} eager={i === 0} />
            </a>
          ))}
          <div class="nav">
            <button type="button" data-step="-1" aria-label="上一个工具"><Icon name="chevronLeft" size={18} /></button>
            <button type="button" data-step="1" aria-label="下一个工具"><Icon name="chevronRight" size={18} /></button>
          </div>
        </div>

        <figcaption class="shot-cap">
          <span class="cap-text">
            <span class="nm">
              <span data-cap="name">{heroTools[0].data.name}</span>
              <span class="alias" data-cap="alias">{heroTools[0].data.alias}</span>
            </span>
            <span class="tg" data-cap="tagline">{heroTools[0].data.tagline}</span>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>最新</h2>
      <a class="more arrow-link" href="/archives/">全部 <span class="num">{posts.length}</span> 篇 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="latest">
      <a class="lead-post" href={postUrl(lead)}>
        <span class="meta num">{formatDate(lead.data.date)} · {lead.data.category}</span>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.description ?? excerpt(lead.body, 150)}</p>
        <span class="read arrow-link">阅读全文 <Icon name="arrowRight" size={16} /></span>
      </a>
      <ul class="compact">
        {recent.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="d num">{md(p)}</span>
              <span class="t">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>按方向读</h2>
      <a class="more arrow-link" href="/tags/">全部分类和标签 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="topics" data-topics>
      <div class="tabs" role="tablist" aria-label="按方向筛选">
        {topics.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`topic-tab-${i}`}
            aria-controls={`topic-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {t.label}<span class="n num">{t.n}</span>
          </button>
        ))}
      </div>
      {topics.map((t, i) => (
        <div class="panel" role="tabpanel" id={`topic-panel-${i}`} aria-labelledby={`topic-tab-${i}`} hidden={i !== 0}>
          <ul>
            {t.items.map((p) => (
              <li>
                <a href={postUrl(p)}>
                  <span class="d num">{md(p)}</span>
                  <span class="t">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="panel-more arrow-link" href={`/categories/${t.name}/`}>{t.name} 全部 <span class="num">{t.n}</span> 篇 <Icon name="arrowRight" size={14} /></a>
        </div>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>小工具</h2>
        <a class="more arrow-link" href="/tools/">全部工具 <Icon name="arrowRight" size={16} /></a>
      </div>
      <ul class="web-row" aria-label="在线工具">
        {WEB_TOOLS.map((t) => (
          <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>
        ))}
      </ul>
      <div class="tool-grid">
        {featured.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>
  )}
  <CodeBlocks />
</BaseLayout>

<script>
  // The stack turns over on its own: the top card slides back and the one under
  // it comes forward. There is no control to click — the picture itself links to
  // its tool, so hovering or focusing pauses the rotation.
  const showcase = document.querySelector<HTMLElement>('.showcase');
  if (showcase) {
    const frames = [...showcase.querySelectorAll<HTMLElement>('[data-panel]')];
    const cap = showcase.querySelector<HTMLElement>('.cap-text')!;
    const nameEl = cap.querySelector<HTMLElement>('[data-cap="name"]')!;
    const aliasEl = cap.querySelector<HTMLElement>('[data-cap="alias"]')!;
    const tagEl = cap.querySelector<HTMLElement>('[data-cap="tagline"]')!;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (i: number) => {
      index = i;
      frames.forEach((f, j) => {
        const active = i === j;
        // The card after the active one waits underneath, showing a sliver of edge.
        const behind = j === (i + 1) % frames.length;
        f.toggleAttribute('data-active', active);
        f.toggleAttribute('data-behind', behind && !active);
        f.setAttribute('aria-hidden', String(!active));
        f.tabIndex = active ? 0 : -1;
      });

      // Swap the words midway through the fade, so they don't change before the picture.
      cap.classList.add('swapping');
      setTimeout(() => {
        const f = frames[i];
        nameEl.textContent = f.dataset.name ?? '';
        aliasEl.textContent = f.dataset.alias ?? '';
        tagEl.textContent = f.dataset.tagline ?? '';
        cap.classList.remove('swapping');
      }, 180);
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (still || frames.length < 2) return;
      timer = setInterval(() => show((index + 1) % frames.length), 7000);
    };

    // Hovering stops the rotation, so the arrows are the way through the stack
    // while the pointer is over it. They also respond to the arrow keys.
    const step = (d: number) => show((index + d + frames.length) % frames.length);
    for (const b of showcase.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      b.addEventListener('click', () => step(Number(b.dataset.step)));
    }
    showcase.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      step(e.key === 'ArrowRight' ? 1 : -1);
    });

    showcase.addEventListener('pointerenter', stop);
    showcase.addEventListener('pointerleave', start);
    showcase.addEventListener('focusin', stop);
    showcase.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }

  // Tabs for the topic list: click or arrow keys switch the panel, following the WAI-ARIA tabs pattern.
  for (const root of document.querySelectorAll<HTMLElement>('[data-topics]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + tabs.length) % tabs.length, true);
      });
    });
  }
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  /* Mark and name read as one lockup; the mark is sized to the cap height of the name. */
  h1 {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  h1 :global(.mark) {
    width: auto;
    height: 0.8em;
  }

  .hero :global(.slogan) {
    margin-top: 20px;
    max-width: 32rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--text-3);
  }

  .lead {
    margin-top: 12px;
    max-width: 32rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-2);
  }

  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Facts sit above the name as a quiet line, so the buttons end the block. */
  .stat {
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--text-3);
  }

  /* The one rich moment: the desktop tools as they actually look. */
  .showcase {
    margin: 0;
    padding: 20px;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }

  /* Cards stack: the active one sits on top, the next peeks out below it, so a
     switch reads as one card sliding over another rather than a plain fade.
     The perspective pushes the back card down the z axis, so the stack has depth
     instead of looking like two flat rectangles. */
  .stage {
    position: relative;
    display: block;
    margin-bottom: 48px;
    perspective: 1100px;
    perspective-origin: 50% 24%;
  }

  .frame {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-sunk);
    opacity: 0;
    transform: translateY(30px) translateZ(-140px) rotateX(10deg) rotateY(-4deg);
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease), box-shadow 0.55s var(--ease);
  }

  .frame[data-behind] {
    opacity: 0.62;
    /* Shifted left and back, so the top card reads as sitting to the right of it. */
    transform: translate(-46px, 62px) translateZ(-150px) rotateX(12deg) rotateY(-8deg);
    z-index: 2;
  }

  .frame[data-active] {
    opacity: 1;
    transform: translateZ(0) rotateX(0deg);
    z-index: 3;
    box-shadow: var(--shadow-md);
    pointer-events: auto;
  }

  /* Chevrons float over the screenshot on hover: no border, a soft surface disc
     and a light shadow, so they read as part of the card rather than as buttons
     dropped on top of it. */
  .nav {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  .nav button {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    box-shadow: 0 1px 6px color-mix(in srgb, var(--text) 12%, transparent);
    color: var(--text-2);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity 0.2s var(--ease), color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .nav [data-step='-1'] {
    left: 12px;
  }

  .nav [data-step='1'] {
    right: 12px;
  }

  .showcase:hover .nav button,
  .nav button:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .nav button:hover {
    background: var(--surface);
    color: var(--text);
  }

  .shot-cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 12px 10px;
  }

  .cap-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    transition: opacity 0.2s var(--ease);
  }

  .cap-text.swapping {
    opacity: 0;
  }

  .shot-cap .nm {
    font-weight: 500;
    font-size: 15px;
  }

  .shot-cap .alias {
    margin-left: 6px;
    font-weight: 400;
    font-size: 13px;
    color: var(--text-3);
  }

  .shot-cap .tg {
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .shot-cap {
      transition: none;
    }
    .frame {
      transform: none;
    }
  }

  .block {
    padding-top: clamp(64px, 9vw, 96px);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .block-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }

  .more {
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .more:hover {
    color: var(--text);
  }

  /* Latest: one lead story beside a compact list */
  .latest {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .lead-post {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lead-post .meta {
    font-size: 13px;
    color: var(--text-3);
  }

  .lead-post h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.3;
    transition: color 0.15s var(--ease);
  }

  .lead-post:hover h3 {
    color: var(--accent);
  }

  .lead-post p {
    color: var(--text-2);
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lead-post .read {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
  }

  .lead-post:hover .read :global(svg) {
    transform: translateX(2px);
  }

  .compact {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compact li + li {
    border-top: 1px solid var(--line);
  }

  .compact a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    font-size: 15px;
  }

  .compact li:first-child a {
    padding-top: 0;
  }

  .compact .d {
    font-size: 13px;
    color: var(--text-3);
  }

  .compact .t {
    transition: color 0.15s var(--ease);
  }

  .compact a:hover .t {
    color: var(--accent);
  }

  /* Topics: one row of tabs, one list. The list keeps the same height whichever tab is open. */
  .topics {
    border-top: 1px solid var(--line);
  }

  .tabs {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .tabs button {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-md);
    background: transparent;
    color: var(--text-2);
    font: 400 15px/36px var(--font);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .tabs button:hover {
    color: var(--text);
    background: var(--bg-sunk);
  }

  .tabs button[aria-selected='true'] {
    color: var(--bg);
    background: var(--text);
  }

  .tabs .n {
    font-size: 12px;
    opacity: 0.6;
  }

  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
  }

  .panel li {
    border-bottom: 1px solid var(--line);
  }

  .panel li a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 16px 0;
    font-size: 15px;
  }

  .panel .d {
    font-size: 13px;
    color: var(--text-3);
  }

  .panel .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .panel li a:hover .t {
    color: var(--accent);
  }

  .panel-more {
    margin-top: 20px;
    font-size: 14px;
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .panel-more:hover {
    color: var(--text);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 24px;
  }

  /* Online tools: one quiet row of links above the desktop app cards. */
  .web-row {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .web-row a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
    transition: border-color 0.15s var(--ease);
  }

  .web-row a:hover {
    border-color: var(--text-3);
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 56px;
      padding-bottom: 64px;
    }
    h1 {
      font-size: 2.75rem;
    }
    .latest {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .panel ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
