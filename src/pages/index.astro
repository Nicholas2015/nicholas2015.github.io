---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import CodeBlocks from '../components/CodeBlocks.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { countBy, excerpt, formatDate, getPosts, getTools, postUrl, type Post } from '../lib/content';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const tools = await getTools();
const featured = (tools.some((t) => t.data.featured) ? tools.filter((t) => t.data.featured) : tools).slice(0, 3);

// One lead story, then a compact list of the next ones.
const [lead, ...rest] = posts;
const recent = rest.slice(0, 6);

// Topic shelves: the busiest categories, newest three posts each.
const shelves = countBy(posts.map((p) => p.data.category))
  .slice(0, 4)
  .map(([name, n]) => ({ name, n, items: posts.filter((p) => p.data.category === name).slice(0, 3) }));

const firstYear = posts.at(-1)?.data.date.getFullYear();
const md = (p: Post) => formatDate(p.data.date).slice(5);

// The step card shows a real sequence from a real post, so readers see what the notes are like.
const stepPost = posts.find((p) => p.id === 'ollama-local-model-deploy') ?? lead;
const steps = `# Linux 一行命令安装
curl -fsSL https://ollama.com/install.sh | sh

# 确认安装成功
ollama -v

# 查看服务是否正常运行
sudo systemctl status ollama`;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="intro">
        <h1 class="rise">{SITE.title}</h1>
        <p class="lead rise rise-2">
          {SITE.author}的技术笔记。Spring AI、RAG、Kafka、Redis、线上排查，一步一步讲清楚，命令可以直接复制
        </p>
        <div class="cta rise rise-3">
          <a class="btn btn-primary arrow-link" href="/archives/">阅读文章 <Icon name="arrowRight" size={16} /></a>
          <a class="btn" href="/subscribe/"><Icon name="rss" size={16} /> 订阅</a>
        </div>
        <p class="stat rise rise-3">
          <span class="num">{posts.length}</span> 篇 · 从 <span class="num">{firstYear}</span> 年写到现在 · 最近更新 <span class="num">{formatDate(lead.data.date)}</span>
        </p>
      </div>

      <figure class="step rise rise-3">
        <a class="step-head" href={postUrl(stepPost)}>
          <span class="step-meta num">{formatDate(stepPost.data.date)} · {stepPost.data.category}</span>
          <span class="step-title">{stepPost.data.title}</span>
        </a>
        <div class="code-frame" data-static>
          <div class="code-bar">
            <span>shell</span>
            <button type="button" class="copy" aria-label="复制命令"></button>
          </div>
          <Code code={steps} lang="shell" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
        </div>
        <figcaption>
          <a class="arrow-link" href={postUrl(stepPost)}>接着看完整步骤 <Icon name="arrowRight" size={14} /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>最新</h2>
      <a class="more arrow-link" href="/archives/">全部 <span class="num">{posts.length}</span> 篇 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="latest">
      <a class="lead-post" href={postUrl(lead)}>
        <span class="meta num">{formatDate(lead.data.date)} · {lead.data.category}</span>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.description ?? excerpt(lead.body, 150)}</p>
        <span class="read arrow-link">阅读全文 <Icon name="arrowRight" size={16} /></span>
      </a>
      <ul class="compact">
        {recent.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="d num">{md(p)}</span>
              <span class="t">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>按方向读</h2>
      <a class="more arrow-link" href="/tags/">全部分类和标签 <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="shelves">
      {shelves.map((s) => (
        <section class="shelf">
          <a class="shelf-head" href={`/categories/${s.name}/`}>
            <h3>{s.name}</h3>
            <span class="num">{s.n} 篇</span>
          </a>
          <ul>
            {s.items.map((p) => (
              <li>
                <a href={postUrl(p)}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>小工具</h2>
        <a class="more arrow-link" href="/tools/">全部工具 <Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="tool-grid">
        {featured.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>
  )}
  <CodeBlocks />
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .lead {
    margin-top: 24px;
    max-width: 32rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-2);
  }

  .cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .stat {
    margin-top: 24px;
    font-size: 13px;
    color: var(--text-3);
  }

  /* The one rich moment: a real step from a real note. */
  .step {
    margin: 0;
    padding: 8px;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }

  .step-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 16px;
  }

  .step-meta {
    font-size: 12px;
    color: var(--text-3);
  }

  .step-title {
    font-weight: 500;
    font-size: 15px;
    transition: color 0.15s var(--ease);
  }

  .step-head:hover .step-title {
    color: var(--accent);
  }

  .step .code-frame {
    border-radius: var(--r-md);
  }

  .step :global(pre) {
    margin: 0;
    padding: 16px 20px;
    font: 400 13.5px/1.75 var(--mono);
    background: var(--code-bg) !important;
    overflow-x: auto;
  }

  .step figcaption {
    padding: 12px 12px 8px;
    font-size: 14px;
  }

  .step figcaption a {
    color: var(--text-2);
    transition: color 0.15s var(--ease);
  }

  .step figcaption a:hover {
    color: var(--text);
  }

  .block {
    padding-top: clamp(64px, 9vw, 96px);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .block-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }

  .more {
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.15s var(--ease);
  }

  .more:hover {
    color: var(--text);
  }

  /* Latest: one lead story beside a compact list */
  .latest {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .lead-post {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lead-post .meta {
    font-size: 13px;
    color: var(--text-3);
  }

  .lead-post h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    transition: color 0.15s var(--ease);
  }

  .lead-post:hover h3 {
    color: var(--accent);
  }

  .lead-post p {
    color: var(--text-2);
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lead-post .read {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
  }

  .lead-post:hover .read :global(svg) {
    transform: translateX(2px);
  }

  .compact {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compact li + li {
    border-top: 1px solid var(--line);
  }

  .compact a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    font-size: 15px;
  }

  .compact li:first-child a {
    padding-top: 0;
  }

  .compact .d {
    font-size: 13px;
    color: var(--text-3);
  }

  .compact .t {
    transition: color 0.15s var(--ease);
  }

  .compact a:hover .t {
    color: var(--accent);
  }

  /* Topic shelves */
  .shelves {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
    overflow: hidden;
  }

  .shelf {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shelf + .shelf {
    border-left: 1px solid var(--line);
  }

  .shelf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .shelf-head h3 {
    font-size: 17px;
    transition: color 0.15s var(--ease);
  }

  .shelf-head:hover h3 {
    color: var(--accent);
  }

  .shelf-head span {
    font-size: 13px;
    color: var(--text-3);
  }

  .shelf ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .shelf li a {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s var(--ease);
  }

  .shelf li a:hover {
    color: var(--text);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 16px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 56px;
      padding-bottom: 64px;
    }
    h1 {
      font-size: 2.75rem;
    }
    .latest {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .shelves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shelf:nth-child(3) {
      border-left: 0;
    }
    .shelf:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .shelves {
      grid-template-columns: minmax(0, 1fr);
    }
    .shelf + .shelf {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
