---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagLabel, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout title={tagLabel(tag!)}>
  <div class="container">
    <header class="page-head">
      <h1 class="rise">{tagLabel(tag!)}</h1>
      <p class="rise rise-2"><span class="num">{posts.length}</span> 篇文章 · <a class="link" href="/tags/">全部标签</a></p>
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  .link {
    color: var(--accent);
  }
</style>
