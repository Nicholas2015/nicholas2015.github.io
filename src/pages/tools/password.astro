---
import WebToolLayout from '../../layouts/WebToolLayout.astro';
---

<WebToolLayout slug="password">
  <div class="pw">
    <div class="result">
      <output class="value num" data-value aria-live="polite"></output>
      <div class="result-acts">
        <button type="button" class="wt-btn" data-regen>换一个</button>
        <button type="button" class="wt-btn primary" data-copy>复制</button>
      </div>
    </div>
    <div class="meter" data-meter>
      <span class="bar"><i data-bar></i></span>
      <span class="meter-text" data-strength></span>
    </div>

    <div class="panel">
      <div class="grp g-len">
        <label for="pw-len" class="lbl">长度</label>
        <div class="len-row">
          <input id="pw-len" type="range" min="6" max="64" value="20" data-len />
          <input type="number" class="wt-input num len-num" min="6" max="64" value="20" data-len-num aria-label="密码长度（数字）" />
        </div>
      </div>

      <fieldset class="grp g-set">
        <legend class="lbl">包含</legend>
        <label><input type="checkbox" data-set="upper" checked /> 大写 A–Z</label>
        <label><input type="checkbox" data-set="lower" checked /> 小写 a–z</label>
        <label><input type="checkbox" data-set="digit" checked /> 数字 0–9</label>
        <label><input type="checkbox" data-set="symbol" checked /> 符号 !@#$…</label>
      </fieldset>

      <div class="grp g-batch">
        <label for="pw-count" class="lbl">一次生成</label>
        <select id="pw-count" class="wt-select" data-count>
          <option value="1" selected>1 个</option>
          <option value="5">5 个</option>
          <option value="10">10 个</option>
        </select>
      </div>

      <fieldset class="grp g-opt">
        <legend class="lbl">选项</legend>
        <label><input type="checkbox" data-opt="ambiguous" checked /> 排除易混字符（0 O o 1 l I）</label>
        <label><input type="checkbox" data-opt="each" checked /> 每种字符至少一个</label>
      </fieldset>
    </div>

    <ul class="list" data-list hidden></ul>
  </div>
</WebToolLayout>

<style>
  .pw {
    max-width: 56rem;
  }

  .result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 16px 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--code-bg);
  }

  .value {
    flex: 1;
    min-width: 0;
    font: 500 20px/1.5 var(--mono);
    letter-spacing: 0.02em;
    word-break: break-all;
    user-select: all;
  }

  .result-acts {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .meter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .bar {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    background: var(--logo-ink);
    transition: width 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .meter-text {
    flex-shrink: 0;
    text-align: right;
    font-size: 13px;
    color: var(--text-3);
  }

  /* Settings sit in one band under the result, so the page never grows a tall empty rail.
     Length and batch are narrow, the character kinds need room, the two options share a full row. */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr) minmax(0, 0.7fr);
    grid-template-areas:
      'len set batch'
      'opt opt opt';
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .g-len { grid-area: len; }
  .g-set { grid-area: set; }
  .g-batch { grid-area: batch; }
  .g-opt { grid-area: opt; }

  .grp {
    min-width: 0;
    margin: 0;
    padding: 20px 24px;
    border: 0;
  }

  .g-len,
  .g-set {
    border-right: 1px solid var(--line);
  }

  .g-opt {
    border-top: 1px solid var(--line);
  }

  .lbl {
    display: block;
    margin-bottom: 12px;
    padding: 0;
    font-size: 13px;
    color: var(--text-3);
  }

  .len-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 12px;
  }

  .len-row input[type='range'] {
    width: 100%;
    accent-color: var(--text);
  }

  .len-num {
    text-align: center;
  }

  .sets,
  .g-set,
  .g-opt {
    display: grid;
    align-content: start;
  }

  .g-set {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
  }

  .g-opt {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
  }

  .g-set legend,
  .g-opt legend {
    grid-column: 1 / -1;
  }

  .g-set label,
  .g-opt label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    cursor: pointer;
  }

  .g-set input,
  .g-opt input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    accent-color: var(--text);
  }

  .g-batch .wt-select {
    width: 100%;
  }

  @media (max-width: 760px) {
    .panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'len set'
        'batch batch'
        'opt opt';
    }
    .g-set {
      border-right: 0;
    }
    .g-batch {
      border-top: 1px solid var(--line);
    }
    .g-set {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'len'
        'set'
        'opt'
        'batch';
    }
    .g-len,
    .g-set {
      border-right: 0;
    }
    .g-set,
    .g-opt {
      border-top: 1px solid var(--line);
    }
    .g-opt {
      grid-template-columns: minmax(0, 1fr);
    }
    .grp {
      padding: 20px;
    }
    .result {
      flex-direction: column;
      align-items: stretch;
    }
    .result-acts {
      justify-content: flex-end;
    }
  }

  /* The batch list rows are created by the script, so they need :global to be styled. */
  .list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .list :global(li) {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 52px;
    padding: 8px 12px 8px 20px;
  }

  .list :global(li + li) {
    border-top: 1px solid var(--line);
  }

  .list :global(li:hover) {
    background: var(--bg-sunk);
  }

  .list :global(code) {
    flex: 1;
    min-width: 0;
    font: 500 15px/1.5 var(--mono);
    letter-spacing: 0.02em;
    word-break: break-all;
    user-select: all;
  }
</style>

<script>
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const SETS = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lower: 'abcdefghijklmnopqrstuvwxyz',
    digit: '0123456789',
    symbol: '!@#$%^&*()-_=+[]{};:,.?/~',
  } as const;
  const AMBIGUOUS = /[0Oo1lI]/g;

  const len = $<HTMLInputElement>('[data-len]');
  const lenNum = $<HTMLInputElement>('[data-len-num]');
  const value = $<HTMLOutputElement>('[data-value]');
  const bar = $<HTMLElement>('[data-bar]');
  const strength = $<HTMLElement>('[data-strength]');
  const count = $<HTMLSelectElement>('[data-count]');
  const list = $<HTMLUListElement>('[data-list]');

  // Uniform pick from 0..n-1 using crypto randomness, rejecting the biased tail.
  const randInt = (n: number) => {
    const max = Math.floor(0x100000000 / n) * n;
    const buf = new Uint32Array(1);
    do crypto.getRandomValues(buf); while (buf[0] >= max);
    return buf[0] % n;
  };

  const pools = () => {
    const amb = $<HTMLInputElement>('[data-opt="ambiguous"]').checked;
    return (Object.keys(SETS) as (keyof typeof SETS)[])
      .filter((k) => $<HTMLInputElement>(`[data-set="${k}"]`).checked)
      .map((k) => (amb ? SETS[k].replace(AMBIGUOUS, '') : SETS[k]));
  };

  const generate = () => {
    const ps = pools();
    const n = Number(len.value);
    if (!ps.length) return '';
    const all = ps.join('');
    const chars = Array.from({ length: n }, () => all[randInt(all.length)]);
    if ($<HTMLInputElement>('[data-opt="each"]').checked && n >= ps.length) {
      // Put one char of each chosen kind at distinct random positions.
      const slots = [...Array(n).keys()];
      for (const p of ps) {
        const i = slots.splice(randInt(slots.length), 1)[0];
        chars[i] = p[randInt(p.length)];
      }
    }
    return chars.join('');
  };

  const rate = () => {
    const ps = pools();
    const size = ps.join('').length;
    const bits = size ? Number(len.value) * Math.log2(size) : 0;
    const [label, pct, color] =
      bits < 40 ? ['弱', 20, '#c2410c'] : bits < 60 ? ['一般', 45, '#b7791f'] : bits < 80 ? ['强', 72, 'var(--logo-ink)'] : ['很强', 100, 'var(--logo-ink)'];
    bar.style.width = `${size ? pct : 0}%`;
    bar.style.background = color;
    strength.textContent = size ? `${label} · 约 ${Math.round(bits)} 位熵` : '至少选一种字符';
  };

  const render = () => {
    rate();
    const first = generate();
    value.textContent = first || '—';
    const n = Number(count.value);
    list.hidden = n === 1;
    list.innerHTML = '';
    if (n > 1) {
      for (let i = 0; i < n; i++) {
        const li = document.createElement('li');
        const code = document.createElement('code');
        code.textContent = i === 0 ? first : generate();
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'wt-mini';
        btn.textContent = '复制';
        btn.addEventListener('click', () => copy(code.textContent ?? '', btn));
        li.append(code, btn);
        list.append(li);
      }
    }
  };

  const copy = async (text: string, btn: HTMLButtonElement) => {
    if (!text || text === '—') return;
    await navigator.clipboard.writeText(text).catch(() => {});
    const old = btn.textContent;
    btn.textContent = '已复制';
    setTimeout(() => (btn.textContent = old), 1400);
  };

  len.addEventListener('input', () => { lenNum.value = len.value; render(); });
  lenNum.addEventListener('change', () => {
    const v = Math.min(64, Math.max(6, Number(lenNum.value) || 20));
    lenNum.value = len.value = String(v);
    render();
  });
  document.querySelectorAll('[data-set], [data-opt]').forEach((el) => el.addEventListener('change', render));
  count.addEventListener('change', render);
  $('[data-regen]').addEventListener('click', render);
  $<HTMLButtonElement>('[data-copy]').addEventListener('click', (e) => copy(value.textContent ?? '', e.currentTarget as HTMLButtonElement));

  render();
</script>
